{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speccy.dev/schemas/profile.schema.json",
  "title": "Speccy profile",
  "description": "The configuration for one doc type: template, limits, links, trace IDs, waivers, approvals, divergence, lint, and checks (SDD §10.3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "name", "template", "checks"],
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "description": "The doc type. A main doc's frontmatter type selects the profile with this key."
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1, "description": "Set by Speccy on save." },
    "template": {
      "type": "string",
      "minLength": 1,
      "description": "Path of the template, relative to the profile file. A heading line that ends with <!-- required --> is required (lint.required-headings)."
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_words": { "type": "integer", "minimum": 1 },
        "max_section_words": { "type": "integer", "minimum": 1 },
        "max_sentence_words": { "type": "integer", "minimum": 1 },
        "max_code_block_lines": { "type": "integer", "minimum": 1 },
        "max_table_rows": { "type": "integer", "minimum": 1 }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kinds", "types"],
          "properties": {
            "kinds": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["implements", "refines", "references", "supersedes"] }
            },
            "types": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "required": { "type": "boolean" }
          }
        },
        "children": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kinds", "min_at"],
          "description": "A doc at min_at or larger must link the bundles it covers (REQ-134).",
          "properties": {
            "kinds": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["implements", "refines", "references", "supersedes"] }
            },
            "min": { "type": "integer", "minimum": 1 },
            "min_at": { "enum": ["feature", "app", "initiative"] }
          }
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefixes": { "type": "array", "items": { "$ref": "#/$defs/prefix" } },
        "cover": { "type": "array", "items": { "$ref": "#/$defs/prefix" } }
      }
    },
    "waivers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "should": { "$ref": "#/$defs/waiverPolicy" },
        "must": { "$ref": "#/$defs/waiverPolicy" }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "required": { "type": "integer", "minimum": 1 } }
    },
    "divergence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readers": { "type": "integer", "minimum": 1, "maximum": 3, "description": "REQ-101 has three reader roles." },
        "questions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          }
        },
        "themes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overrides": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/lintSlug" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level"],
            "properties": { "level": { "enum": ["MUST", "SHOULD", "INFO", "off"] } }
          }
        },
        "slop_extra": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "level", "stage"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$" },
          "level": { "enum": ["MUST", "SHOULD", "INFO"] },
          "stage": { "enum": ["rubric", "grounding", "divergence", "coherence"] },
          "scope": { "enum": ["doc", "section"] },
          "question": { "type": "string" },
          "pass_when": { "type": "string" },
          "waiver": { "$ref": "#/$defs/waiverPolicy" },
          "sizes": {
            "type": "array",
            "items": { "enum": ["feature", "app", "initiative"] },
            "description": "The doc sizes this check applies to. An empty list applies at every size."
          }
        }
      }
    }
  },
  "$defs": {
    "prefix": { "type": "string", "pattern": "^[A-Z]{2,6}$" },
    "lintSlug": {
      "enum": [
        "lint.placeholder",
        "lint.required-headings",
        "lint.broken-link",
        "lint.duplicate-id",
        "lint.dangling-ref",
        "lint.slop-phrase",
        "lint.sentence-length",
        "lint.weasel",
        "lint.undefined-acronym",
        "lint.rfc2119-case",
        "lint.prose-limit",
        "lint.asset-nudge",
        "lint.passive-voice"
      ]
    },
    "waiverPolicy": {
      "description": "Who can approve a waiver (SDD §9.1).",
      "oneOf": [
        { "enum": ["any_member", "non_author", "maintainer", "forbidden"] },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["n_approvals"],
          "properties": { "n_approvals": { "type": "integer", "minimum": 1 } }
        }
      ]
    }
  }
}
